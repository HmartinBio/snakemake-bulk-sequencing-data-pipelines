    "../../data/Chip-Seq/GenomeFasta/Mus_musculus.GRCm38.dna.primary_assembly.fa"
)
genomeIndexFolder = "../../data/Chip-Seq/GenomeIndexFolder/MusMusculus"
bedGenesFiles = "../../data/Chip-Seq/BEDFile/Mus_musculus.GRCm38.100.bed"
