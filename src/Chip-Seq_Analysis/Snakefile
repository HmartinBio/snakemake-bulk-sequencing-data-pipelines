    BedFilesFolders = f"../../output/Chip-Seq/{ChIPType}/{DATASET}/BedFiles/{peaksCallingType}"

    # If the pipeline is run in CutAndRun mode

    if INPUTDATASET == "":
        PeaksCallingTuple = fileManagement.creatingpeakscallingfolders(
            ctrlcondition=DatasetCtrlAbrevInFile,
            files=outputFolderBasenameNames,
            peakscallingtype=peaksCallingType,
        )

        PeaksCallingFoldersBasenames = PeaksCallingTuple[0]
        AssembledFilesPeaksCalling = PeaksCallingTuple[1]

    else:
        # Computing specific folder names and filenames
        # to input if we run the pipeline by calling peaks with 
        # input

        SAMPLESFILESINPUT = InputFileManagement.returninglistofsamples()
        
        OUTPUTFOLDERSPELENGTHInput = (
            InputFileManagement.returningpairedendlengthoutputfolders()
        )
        
        pairedEndFoldersBasenamesInput = (
            InputFileManagement.returnlistofsampleswthoutpe()
        )
        
        OUTPUTFOLDERSInput = InputFileManagement.returningoutputfolders()

        # If Paired-end mode

        if PairedEnd:
            outputFolderNamesInput = OUTPUTFOLDERSPELENGTHInput
            outputFolderBasenameNamesInput = pairedEndFoldersBasenamesInput

        else:
            outputFolderNamesInput = OUTPUTFOLDERSInput
            outputFolderBasenameNamesInput = SAMPLESFILESINPUT


        BAMFoldersInput = [
            f"{pathway}/NoDup/{sample}"
            for pathway, sample in zip(
                outputFolderNamesInput, outputFolderBasenameNamesInput
            )
        ]

        BAMMergedFoldersInput = [
            f"../../output/Chip-Seq/{ChIPType}/{INPUTDATASET}/BamFilesMerged/{dataType}"
            for dataType in DATATYPE
        ]

        InputFilesPCRRemoved = [
            f"{pathway}/{sample}_filtered_nodup.bam"
            for pathway, sample in zip(BAMFoldersInput, outputFolderBasenameNamesInput)
        ]

        sortedInputFilesPCRRemoved = fileManagement.sortingbyconditions(
            ctrlcondition=DatasetCtrlAbrevInFile,
            files = InputFilesPCRRemoved)

        InputFilesMergedBam = [
            f"{bamFilesFolder}/{INPUTDATASET}_{dataType}.bam"
            for bamFilesFolder, dataType in zip(BAMMergedFoldersInput, DATATYPE)
        ]


        PeaksCallingTuple = fileManagement.creatingpeakscallingfolders(
            ctrlcondition=DatasetCtrlAbrevInFile,
            files=outputFolderBasenameNames,
            peakscallingtype=peaksCallingType,
            inputfiles=outputFolderBasenameNamesInput,
        )

        PeaksCallingFoldersBasenames = PeaksCallingTuple[0]
        AssembledFilesPeaksCalling = PeaksCallingTuple[1]



    PeaksCallingFolders = [
        f"../../output/Chip-Seq/{ChIPType}/{DATASET}/PeaksCalling/{peaksCallingType}/{sample}"
        for sample in PeaksCallingFoldersBasenames
    ]

    FripFolders = [
        f"../../output/Chip-Seq/{ChIPType}/{DATASET}/FRIPScore/{peaksCallingType}/{sample}"
        for sample in PeaksCallingFoldersBasenames
    ]

    

    # Extending the list of folders with the new ones

    listOfFoldersToCreate.extend(
        [
            fingerprintsPlotsFolders,
            StrandCorrelationFolders,
            PeaksCallingFolders,
            FripFolders,
            BedFilesFolders,
            CoverageMatrixFolders,
        ]
    )


else:
    InputFileManagement = FileManagement(
        dataset=INPUTDATASET,
        datasetype=DATATYPE,
        inputpath=f"../../data/Chip-Seq/Fastq/{ChIPType}/",
        outputpath=f"../../output/Chip-Seq/{ChIPType}/",
        pairedend=PairedEnd,
    )

    # Computing specific folder names and filenames

    SAMPLESFILESINPUT = InputFileManagement.returninglistofsamples()
    OUTPUTFOLDERSPELENGTHInput = (
        InputFileManagement.returningpairedendlengthoutputfolders()
    )
    pairedEndFoldersBasenamesInput = InputFileManagement.returnlistofsampleswthoutpe()
    OUTPUTFOLDERSInput = InputFileManagement.returningoutputfolders()

    BAMMergedFoldersInput = [
        f"../../output/Chip-Seq/{ChIPType}/{INPUTDATASET}/BamFilesMerged/{dataType}"
        for dataType in DATATYPE
    ]

    InputFilesMergedBam = [
        f"{bamFilesFolder}/{INPUTDATASET}_{dataType}.bam"
        for bamFilesFolder, dataType in zip(BAMMergedFoldersInput, DATATYPE)
    ]

    if PairedEnd:
        outputFolderNamesInput = OUTPUTFOLDERSPELENGTHInput
        outputFolderBasenameNamesInput = pairedEndFoldersBasenamesInput

    else:
        outputFolderNamesInput = OUTPUTFOLDERSInput
        outputFolderBasenameNamesInput = SAMPLESFILESINPUT

    PeaksCallingFolders = [
        f"../../output/Chip-Seq/{ChIPType}/{DATASET}/PeaksCalling/{peaksCallingType}MergedInputBam/{dataType}"
        for dataType in DATATYPE
    ]

    PeaksCallingTuple = fileManagement.creatingpeakscallingfolders(
        ctrlcondition=DatasetCtrlAbrevInFile,
        files=outputFolderBasenameNames,
        peakscallingtype=peaksCallingType,
        inputfiles=outputFolderBasenameNamesInput,
    )

    PeaksCallingFoldersBasenames = PeaksCallingTuple[0]
    AssembledFilesPeaksCalling = PeaksCallingTuple[1]


# Creating selected folders according data


for directory in listOfFoldersToCreate:
    if type(directory) is list:
        for directoryInList in directory:
            shell(f"mkdir -p {directoryInList}")
    else:
        shell(f"mkdir -p {directory}")


# Creating necessary output fillesnames for the all rules


HTMLReportFASTQCBefTrimming = [
    f"{pathway}/{sample}_fastqc.html"
    for pathway, sample in zip(FASTQCFolders, SAMPLESFILES)
]


FASTQsamplesAfterTrimming = [
    f"{samples}" for samples in 
        fileManagement.returningtrimmingsamples()
]


samFilesMapping = [
    f"{pathway}/{sample}.sam" for pathway, sample in 
