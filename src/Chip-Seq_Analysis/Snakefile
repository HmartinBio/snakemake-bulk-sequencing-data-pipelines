# Loading Librairies

import sys
import subprocess
from snakemake.utils import min_version
import os


from lib.scripts.FileManagement import FileManagement


# Workflow works only from Snkamake 6.0 version

min_version("6.0")


# Defining variables to use in the workflow

ChIPType = "" # (data/Chip-Seq)/"technology type"
DATASET = "RichardData/ESC" # (data/Chip-Seq/Fastq)/"Dataset"
INPUTDATASET = ""
DATATYPE = ["Control"] # (data/Chip-Seq/Fastq/Dataset)/"Condition1", "Condition2"
DatasetCtrlAbrevInFile = "ESC_Kat5_"
threadsNumber = workflow.cores
OSComputer = "Linux"
CondaEnvPathName = "/media/sheikhhpc/58bd26c7-a7e6-47a0-8bbc-524b51ca4a32/micromamba/envs/ChIPAnalysisMamba"
condaEnvironment = "ChIPAnalysisMambaLinux.yml"
