# Computing the FileManagement object to handle with files

fileManagement = FileManagement(
    dataset=DATASET,
    datasetype=DATATYPE,
    inputpath=f"../../data/Chip-Seq/Fastq/{ChIPType}/",
    outputpath=f"../../output/Chip-Seq/{ChIPType}/",
    pairedend=PairedEnd,
)


# Loading input dataset to compute plots and peaks calling

if DATASET != INPUTDATASET:
    if INPUTDATASET != "":
        InputFileManagement = FileManagement(
            dataset=INPUTDATASET,
            datasetype=DATATYPE,
            inputpath=f"../../data/Chip-Seq/Fastq/{ChIPType}/",
            outputpath=f"../../output/Chip-Seq/{ChIPType}/",
            pairedend=PairedEnd,
        )




# Listing all the files and dataset types

OUTPUTFOLDERS = fileManagement.returningoutputfolders()
SAMPLESFILES = fileManagement.returninglistofsamples()
FASTQSAMPLESFOLDERS = fileManagement.returninputfolders()


# For paired end files

pairedEndFoldersBasenames = fileManagement.returnlistofsampleswthoutpe()
OUTPUTFOLDERSPELENGTH = fileManagement.returningpairedendlengthoutputfolders()


# If data are paired end data pairedEndFoldersBasenames is used
# else it is OUTPUTFOLDERS which are used to compute
# destination filenames and foldernames

if PairedEnd:
    outputFolderNames = OUTPUTFOLDERSPELENGTH
    outputFolderBasenameNames = pairedEndFoldersBasenames

else:
    outputFolderNames = OUTPUTFOLDERS
    outputFolderBasenameNames = SAMPLESFILES


# Creating the folders for the main steps of the workflow
# These folders are always created even if the workflow
# is used to process input raw data


FASTQCFolders = [
    "{pathway}/FastQC/{sample}".format(pathway=pathway, sample=sample)
    for pathway, sample in zip(outputFolderNames, outputFolderBasenameNames)
]


if PairedEnd:
    newFASTQCFolders = []

    for folder in FASTQCFolders:
        newFASTQCFolders.append(folder)
        newFASTQCFolders.append(folder)

    FASTQCFolders = newFASTQCFolders
    del newFASTQCFolders


TrimGalorePaths = [
    f"{pathway}/Trimming/{sample}"
    for pathway, sample in zip(outputFolderNames, outputFolderBasenameNames)
]

