    datasetType=DATASET, dataType=dataType) for dataType in DATATYPE]

BedFilesFolders = '../../output/ATAC-Seq/{datasetType}/BedFiles/{peaksCallingType}'.format(
    datasetType=DATASET, peaksCallingType=peaksCallingType)


    
PeaksCallingTuple = fileManagement.creatingpeakscallingfolders(ctrlcondition=DatasetCtrlAbrevInFile, 
    files=outputFolderBasenameNames, peakscallingtype=peaksCallingType)
        
PeaksCallingFoldersBasenames = PeaksCallingTuple[0]
AssembledFilesPeaksCalling = PeaksCallingTuple[1]

   
    
PeaksCallingFolders = ['../../output/ATAC-Seq/{datasetType}/PeaksCalling/{peaksCallingType}/{sample}'.format(datasetType=DATASET, 
    peaksCallingType=peaksCallingType, sample=sample) for sample in PeaksCallingFoldersBasenames]

SafFolder = '../../output/ATAC-Seq/{datasetType}/FRIPScore/{peaksCallingType}'.format(
    datasetType=DATASET, peaksCallingType=peaksCallingType)

FripFolders = ['../../output/ATAC-Seq/{datasetType}/FRIPScore/{peaksCallingType}/{sample}'.format(datasetType=DATASET, 
    peaksCallingType=peaksCallingType, sample=sample) for sample in PeaksCallingFoldersBasenames] 



# Extending the list of folders with the new ones

listOfFoldersToCreate.extend([fingerprintsPlotsFolders, 
    StrandCorrelationFolders, PeaksCallingFolders, SafFolder, 
    FripFolders, BedFilesFolders, CoverageMatrixFolders])






# Creating selected folders according data 


for directory in listOfFoldersToCreate:
    if type(directory) is list:
        for directoryInList in directory:
            shell("mkdir -p {folder}".format(folder=directoryInList))
    else:
        shell("mkdir -p {folder}".format(folder=directory))




# Creating necessary output for the all rule 


HTMLReportFASTQCBefTrimming = ["{pathway}/{sample}_fastqc.html".format(
    pathway=pathway, sample=sample) for pathway, sample in zip(FASTQCFolders, SAMPLESFILES)]


FASTQsamplesAfterTrimming = ["{samples}".format(samples=samples) 
    for samples in fileManagement.returningtrimmingsamples()]


samFilesMapping = ["{pathway}/{sample}.sam".format(pathway = pathway, 
            sample=sample) for pathway, sample in zip(MappingFolders, 
            outputFolderBasenameNames)]


