    for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)])
        
outputListRule.append(['{coverageMatrix}/{datasetType}_around_TSS_profile.png'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)\
    for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)])
        
outputListRule.append(['{coverageMatrix}/{datasetType}_around_TSS_matrix.png'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)\
    for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)])





# Beginning of the workflow

rule all:
    input:
        outputListRule







# Performing FastQC before trimming

rule fastQCBeforeTrim:
    input:
       ["{pathway}/{files}.fastq.gz".format(pathway=pathway, files=files)\
        for pathway, files in zip(FASTQSAMPLESFOLDERS, SAMPLESFILES)]

    output:
        htmlFASTAQC=HTMLReportFASTQCBefTrimming, 
        zipFASTAQC=["{pathway}/{sample}_fastqc.zip".format(pathway=pathway, sample=sample)\
        for pathway, sample in zip(FASTQCFolders, SAMPLESFILES)]


    threads: threadsNumber

    conda: condaEnvironment

    params: 
        outputFolders=FASTQCFolders,
        cpusPerTasks=cpusPerTasks,

    script:
        scriptPath + "/FASTQC.py"









# Performing the trimming 

rule TrimGalore:
    input:
        rules.fastQCBeforeTrim.input
    
    output:
        FASTQsamplesAfterTrimming
        

    conda: condaEnvironment

    params: 
        outputFolders=TrimGalorePaths,
        cpusPerTasks=cpusPerTasks,

    threads: threadsNumber

    script: 
        scriptPath + "/TrimGalore.py"







# Performing the mapping 

rule MappingReadsOnGenome:
    input:
        FoldersTrimmedFastQ=TrimGalorePaths, 
        TrimmedFasta=rules.TrimGalore.output

    output:
       samFilesMapping
    
    params: 
        referenceGenome=referenceGenome, 
        genomeIndexFolder=genomeIndexFolder, 
        organism=organism,
        cpusPerTasks=cpusPerTasks,

    conda: condaEnvironment

    threads: threadsNumber

    script: 
        scriptPath + "/Mapping.py"







# Computing a 'Mapping Report'

rule samStatMapping:
    input:
        rules.MappingReadsOnGenome.output
    
    output:
        SamStatsReports=samStatReportFilesMapping,
        SamFlagsReports=samFlagReportFilesMapping
        

    params:
        plotFolder=samStatMappingFolders 

    conda: condaEnvironment

    threads: threadsNumber

    script: 
        scriptPath + '/SamStats.py'






# Removing the reads with a poor MappingQuality


rule MAPQ:
    input:
        rules.MappingReadsOnGenome.output

    output:
        bamFilesMAPQFiltering
    
    conda: condaEnvironment

    threads: threadsNumber

    params: 
        referenceGenome=referenceGenome,
        cpusPerTasks=cpusPerTasks,

    script: 
        scriptPath + "/FilteringMappingQuality.py"







# Generating a report relative to the reads trimmed by Mapping Quality

rule samStatMAPQ:
    input:
        rules.MAPQ.output
    
    output:
        SamStatsReports=samStatReportFilesMAPQFiltering,
        SamFlagsReports=samFlagReportFilesMAPQFiltering
        

    params:
        plotFolder=samStatMAPQFolders 

    conda: condaEnvironment

    threads: threadsNumber

    script: 
        scriptPath + '/SamStats.py'




# Deleting PCR duplicates 

rule removePCRDuplicates:
    input:
        rules.MAPQ.output
    
    output: 
        bamFiles=bamFilesPCRDuplicatesFiltered, 
        
        indexedBamFiles=["{pathway}/{sample}_filtered_nodup.bam.bai".format(pathway=pathway, sample=sample) 
            for pathway, sample in zip(PCRDuplicatesRemovedFolders, outputFolderBasenameNames)], 
        
        metricsFiles=["{pathway}/{sample}_filtered_nodup_metrics.txt".format(pathway=pathway, sample=sample) 
            for pathway, sample in zip(PCRDuplicatesRemovedFolders, outputFolderBasenameNames)]

    conda: condaEnvironment

    threads: threadsNumber

    script: 
        scriptPath +  "/MarkDuplicates.py"








# Report concerning the PCR duplicates removing 

rule samStatPCRDuplicates:
    input:
        rules.removePCRDuplicates.output
    
    output:
        SamStatsReports=samStatReportFilesPCRDuplicatesRemoved,
        SamFlagsReports=samFlagReportFilesPCRDuplicatesRemoved
        

    params:
        plotFolder=samStatsPCRDuplicatesRemoveFolders 

    conda: condaEnvironment

    threads: threadsNumber

    script: 
        scriptPath + '/SamStats.py'




# Quality Control of the reads strandness 

rule QualControl:
    input:
        rules.removePCRDuplicates.output.bamFiles
    
    output: 
        strandnessOutputFiles = strandnessMetricsFiles,
        checkCoverageOutputFiles = checkCoverageMetricsFiles,
        mappingCoverageOutputFiles = mappingCoverageMetricsFiles,
        genesDistribOutputFiles = genesDistribMetricsFiles,

    conda: condaEnvironment

    threads: threadsNumber

    params:
        bedGenesFiles = bedGenesFiles,
        cpusPerTasks=cpusPerTasks,

    script: 
        scriptPath + "/QualCheck.py"





# Computing bigWig files

rule bamCoverage:
    input:
        rules.removePCRDuplicates.output.bamFiles
    
    output:
        bigWigFiles

    conda: condaEnvironment

    params: 
        referenceGenome=referenceGenome,
        cpusPerTasks=cpusPerTasks,

    threads: threadsNumber

    script: 
        scriptPath + "/bigWigComputation.py"





# Merging Bigwig and comparing them from bam files

if singleDataset:
    rule bigWigMerge:
        input:
            CtrlBamFiles = conditionSortedbamFilesPCRDuplicatesFiltered[0]

        output: 
            bamFilesMerged=mergedBamFiles, 
            bamFilesIndexMerged=indexMergedBamFiles, 
            bigWigMergedFiles=mergedBigWigFiles, 
            bigWigComapreFile=bigWigOfConditionComparison

        conda: condaEnvironment

        params: 
            referenceGenome=referenceGenome,
            cpusPerTasks=cpusPerTasks,
            singleDataset=singleDataset

        script: 
            scriptPath + "/MergeBigWig.py"
else:
    rule bigWigMerge:
        input:
            CtrlBamFiles = conditionSortedbamFilesPCRDuplicatesFiltered[0], 
            TreatBamFiles = conditionSortedbamFilesPCRDuplicatesFiltered[1]

        output: 
            bamFilesMerged=mergedBamFiles, 
            bamFilesIndexMerged=indexMergedBamFiles, 
            bigWigMergedFiles=mergedBigWigFiles, 
            bigWigComapreFile=bigWigOfConditionComparison

        conda: condaEnvironment

        params: 
            referenceGenome=referenceGenome,
            cpusPerTasks=cpusPerTasks,
            singleDataset=singleDataset

        script: 
            scriptPath + "/MergeBigWig.py"





# Computing a correlation plot between samples 

rule correlationBamPlot:
    input:
        rules.removePCRDuplicates.output.bamFiles
    output:
        multiBamSummary=multiBamSummary, 
        correlationPlot=correlationBamPlot,
        correlationMatrix=correlationBamMatrix

    params: 
        sampleNames = outputFolderBasenameNames

    conda: condaEnvironment

    script: scriptPath + "/CorrelationBamPlot.py"




# Computing Lorenz curves for quality control 

if singleDataset:
    
    rule plotFingerPrint:
        input:
            datasetFilesCtrl = fileManagement.sortingbyconditions(ctrlcondition=DatasetCtrlAbrevInFile, 
                files=rules.removePCRDuplicates.output.bamFiles)[0]
        
        output:
            plotFingerprintPicture=plotFingerPrintFigure, 
            plotFingerprintRawCounts=summaryResultsPlotFingerprintsFile
    
        params:
            InputFilesCtrl = "False", 
            InputFilesTreat = "False",
            cpusPerTasks=cpusPerTasks,
            singleDataset=singleDataset,


        conda: condaEnvironment

        threads: threadsNumber

        script: scriptPath + '/plotFingerPrint.py'


else:
    rule plotFingerPrint:
        input:
            datasetFilesCtrl = fileManagement.sortingbyconditions(ctrlcondition=DatasetCtrlAbrevInFile, 
                files=rules.removePCRDuplicates.output.bamFiles)[0], 
            
            datasetFilesTreat = fileManagement.sortingbyconditions(ctrlcondition=DatasetCtrlAbrevInFile, 
                files=rules.removePCRDuplicates.output.bamFiles)[1]
        
        output:
            plotFingerprintPicture=plotFingerPrintFigure, 
            plotFingerprintRawCounts=summaryResultsPlotFingerprintsFile
    
        params:
            InputFilesCtrl = "False", 
            InputFilesTreat = "False",
            cpusPerTasks=cpusPerTasks,
            singleDataset=singleDataset,


        conda: condaEnvironment

        threads: threadsNumber

        script: scriptPath + '/plotFingerPrint.py'




    


# Computing Strand cross-correlation plots

rule SPP:
    input:
        rules.removePCRDuplicates.output.bamFiles

    output:
        phantomPeaksPictures=strandCorrelationsOutputFigures, 
        phantomPeaksResults=strandCorrelationOutputFiles

    conda: condaEnvironment

    threads: threadsNumber

    params: CondaEnvPathName=CondaEnvPathName

    script: 
        scriptPath + "/phantompeaks.py"




# Computing the coverage matrix to prepare data for 
# heatmap and coverage analysis

if not singleDataset:
    rule coveraGeMatrix:
        input:
            datasetFilesCtrl = rules.bigWigMerge.output.bigWigMergedFiles[0], 
            datasetFilesTreat = rules.bigWigMerge.output.bigWigMergedFiles[1], 
            bedFiles=bedGenesFiles
        
        output:
            gzipMatrixFile = ['{coverageMatrix}/{datasetType}_around_TSS_matrixFile.gz'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)
                for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)], 
            
            heatmapMatrixFile = ['{coverageMatrix}/{datasetType}_around_TSS_HeatmapMatrixFile'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)\
                for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)]
        

        conda:condaEnvironment

        threads: threadsNumber

        script:'lib/scripts/ComputeCoverageMatrix.py'


else:
    rule coveraGeMatrix:
        input:
            datasetFilesCtrl = rules.bigWigMerge.output.bigWigMergedFiles[0],
            bedFiles=bedGenesFiles
        
        output:
            gzipMatrixFile = ['{coverageMatrix}/{datasetType}_around_TSS_matrixFile.gz'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)
                for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)], 
            
            heatmapMatrixFile = ['{coverageMatrix}/{datasetType}_around_TSS_HeatmapMatrixFile'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)\
                for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)]

        params: 
            cpusPerTasks=cpusPerTasks,
            singleDataset=singleDataset,
            typeheatmap=typeheatmap        

        conda:condaEnvironment

        threads: threadsNumber

        script:'lib/scripts/ComputeCoverageMatrix.py'


   


# Computing the profile plot around the TSS
    
rule profilePlotTSS:
    input:
        rules.coveraGeMatrix.output

    output:
        ['{coverageMatrix}/{datasetType}_around_TSS_profile.png'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)\
            for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)]

    conda: condaEnvironment

    params:
        cpusPerTasks=cpusPerTasks,
        singleDataset=singleDataset,
        typeheatmap=typeheatmap

    script: 'lib/scripts/ComputeProfileAroundTSS.py'
    


# Computing the heatmap plot around the TSS

rule heatmapPlotTSS:
    input:
        rules.coveraGeMatrix.output
        
    output:
        ['{coverageMatrix}/{datasetType}_around_TSS_matrix.png'.format(coverageMatrix=coverageMatrix, datasetType=datasetType)\
            for coverageMatrix, datasetType in zip(CoverageMatrixFolders, DATATYPE)]

    params:
        cpusPerTasks=cpusPerTasks,
        singleDataset=singleDataset,
        typeheatmap=typeheatmap

    conda: condaEnvironment

    script: 'lib/scripts/ComputeHeatmapAroundTSS.py'



# Peaks calling 

if singleDataset:
    rule PeaksCalling:
        input:
            datasetFiles = rules.removePCRDuplicates.output.bamFiles,
            datasetFilesCtrl = rules.plotFingerPrint.input.datasetFilesCtrl,
            datasetFilesTreat = rules.plotFingerPrint.input.datasetFilesTreat
        
        output: peaksCallingOutputFiles
        
        conda: condaEnvironment

        threads: threadsNumber

        params: 
            peaksCallingType = peaksCallingType, 
            outDirs = PeaksCallingFolders,
            CtrlCondition = DatasetCtrlAbrevInFile, 
            AssembledFilesPeaksCalling = AssembledFilesPeaksCalling,
            cpusPerTasks=cpusPerTasks,
            organism=organism,

        script:
            scriptPath + '/MACS2.py'


