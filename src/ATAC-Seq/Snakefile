mergedBigWigFiles = ['{bigWigFolder}/{dataset}_{dataType}.bw'.format(
    bigWigFolder=bigWigFolder, dataset=DATASET, dataType=dataType) for bigWigFolder, dataType in zip(
        BigWigMergeFolders, DATATYPE)]


